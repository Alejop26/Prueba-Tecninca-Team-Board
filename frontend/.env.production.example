# Usadas solo en build de producción (`npm run build`) para desplegar en S3/CloudFront.
# En local no hace falta definirlas: se usa el proxy de Vite hacia la API Express.

# URL pública de la API en EC2 (auth, notes, users)
VITE_API_BASE=http://<EC2_PUBLIC_DNS>/api

# URL de invocación del API Gateway que expone la Lambda del dashboard
VITE_DASHBOARD_API_BASE=https://<api-id>.execute-api.<region>.amazonaws.com/metrics
